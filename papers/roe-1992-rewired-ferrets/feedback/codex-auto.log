      const px = 42 + value * 7;
      dot.style.width = px + "px";
      dot.style.height = px + "px";
      document.getElementById("a1SliderOut").textContent = value.toFixed(1) + " deg";
      document.getElementById("a1FieldOut").textContent = value.toFixed(1);
    }

    function answerQuiz(btn, correct) {
      const box = btn.closest(".quiz-box");
      box.querySelectorAll(".quiz-options button").forEach((el) => {
        el.classList.remove("correct", "wrong");
      });
      btn.classList.add(correct ? "correct" : "wrong");
      box.querySelector(".quiz-feedback").classList.add("show");
    }


